# --- OpenAI (CV analysis / chat) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1

# --- Database (defaults to an in-memory H2 DB if left unset) ---
# Local dev: a direct connection (as below) or a local Postgres instance both work fine.
# Render/production: use Supabase's connection pooler in SESSION mode instead of the direct
# db.<project-ref>.supabase.co host (Project Settings > Database > Connection pooling) - a hosted
# platform's connection count adds on top of everything else sharing the same Supabase project,
# and the pooler is built for exactly that. Session mode (not transaction mode) because this app
# uses normal JDBC/Hikari connections. The pooler username is postgres.<project-ref>, not plain
# postgres. Example: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobmatchai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=10000
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# --- Auth (JWT) ---
# Generate a long random string for production, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying
JWT_EXPIRATION_MS=86400000

# --- CORS / frontend URL ---
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173

# --- Environment ---
# "dev" returns password-reset links directly in API responses for local testing.
# Set to "prod" before deploying so reset links are only ever emailed, never returned.
APP_ENVIRONMENT=dev

# --- File storage ---
# Must be an absolute path outside the project directory and outside version control -
# uploaded CVs contain real personal data and must never end up in a git repo. Left
# unset, it defaults to a folder under the user's home directory (see
# application.properties), which is fine for local dev but NOT for production: a
# container's local disk does not survive a redeploy/restart, so production should
# point this at a persistent mounted volume or object storage instead.
APP_UPLOAD_DIR=/var/jobmatchai/uploads/cvs/

# --- Supabase Storage (only read when APP_STORAGE_TYPE=supabase - see application-production.properties,
# which sets this automatically for the production profile). Get these from the Supabase dashboard:
# Project Settings > API for the URL and service_role key, Storage for the bucket name (create one,
# e.g. "cvs", if it doesn't exist yet). SUPABASE_SERVICE_ROLE_KEY bypasses row-level security -
# treat it like a database password, never commit it. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cvs

# --- Payments ---
# This app uses a simulated/demo payment flow (see PaymentController's /api/payments/demo/* routes)
# - no Stripe account or API keys required. The real Stripe integration code paths still exist but
# are inert with these left blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# --- Email (forgot password). Leave blank to use dev-mode (link is logged/returned instead of emailed). ---
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as MAIL_PASSWORD (not your real password).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- External jobs import ---
JOOBLE_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com
EXTERNAL_JOBS_COUNTRY=il
# Left unset intentionally - the built-in default already covers ~50 broad job categories
# (accountant, nurse, teacher, driver, software developer, etc. - see
# externaljobs.import.keywords in application.properties). Only set this if you want to
# NARROW imports to specific comma-separated keywords instead of that full default list.
# EXTERNAL_JOBS_KEYWORDS=software developer,web developer
EXTERNAL_JOBS_IMPORT_CRON=0 0 */6 * * *

# --- Internal operator/cron endpoints ---
# Required to call POST /api/external-jobs/import (there's no admin role to gate it with
# instead, and it fans out to paid third-party APIs). Leave blank to keep it fully disabled -
# the scheduled cron above runs regardless of this. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=
